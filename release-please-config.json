{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "plymouth-3dboot",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(!@.source)].version"
        },
        {
          "type": "generic",
          "path": "plymouth/meson.build"
        },
        {
          "type": "generic",
          "path": "packaging/plymouth-3dboot.spec"
        },
        {
          "type": "generic",
          "path": "crates/plymouth-3dboot-capi/src/lib.rs"
        },
        {
          "type": "generic",
          "path": "crates/plymouth-3dboot-capi/cbindgen.toml"
        },
        {
          "type": "generic",
          "path": "crates/plymouth-3dboot-capi/include/plymouth-3dboot.h"
        }
      ]
    }
  }
}
