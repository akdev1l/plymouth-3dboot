<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- Synthetic test fixture: BEZIER ease-in-out on translate.X, 0 -> 3 over 1 s, then back over 1 s -->
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><unit meter="1" name="meter"/><up_axis>Y_UP</up_axis></asset>
  <library_animations>
    <animation id="ease">
      <source id="ease-input">
        <float_array id="ease-input-array" count="3">0 1 2</float_array>
        <technique_common><accessor source="#ease-input-array" count="3" stride="1"><param name="TIME" type="float"/></accessor></technique_common>
      </source>
      <source id="ease-output">
        <float_array id="ease-output-array" count="3">0 3 0</float_array>
        <technique_common><accessor source="#ease-output-array" count="3" stride="1"><param name="X" type="float"/></accessor></technique_common>
      </source>
      <!-- Flat tangents: control points at one third of each segment. -->
      <source id="ease-intan">
        <float_array id="ease-intan-array" count="6">-0.333333 0 0.666667 3 1.666667 0</float_array>
        <technique_common><accessor source="#ease-intan-array" count="3" stride="2"><param name="X" type="float"/><param name="Y" type="float"/></accessor></technique_common>
      </source>
      <source id="ease-outtan">
        <float_array id="ease-outtan-array" count="6">0.333333 0 1.333333 3 2.333333 0</float_array>
        <technique_common><accessor source="#ease-outtan-array" count="3" stride="2"><param name="X" type="float"/><param name="Y" type="float"/></accessor></technique_common>
      </source>
      <source id="ease-interpolation">
        <Name_array id="ease-interpolation-array" count="3">BEZIER BEZIER BEZIER</Name_array>
        <technique_common><accessor source="#ease-interpolation-array" count="3" stride="1"><param name="INTERPOLATION" type="name"/></accessor></technique_common>
      </source>
      <sampler id="ease-sampler">
        <input semantic="INPUT" source="#ease-input"/>
        <input semantic="OUTPUT" source="#ease-output"/>
        <input semantic="IN_TANGENT" source="#ease-intan"/>
        <input semantic="OUT_TANGENT" source="#ease-outtan"/>
        <input semantic="INTERPOLATION" source="#ease-interpolation"/>
      </sampler>
      <channel source="#ease-sampler" target="easer/location.X"/>
    </animation>
  </library_animations>
  <library_geometries>
    <geometry id="tri" name="tri">
      <mesh>
        <source id="tri-pos">
          <float_array id="tri-pos-array" count="9">0 0 0 1 0 0 0 1 0</float_array>
          <technique_common><accessor source="#tri-pos-array" count="3" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
        </source>
        <vertices id="tri-vtx"><input semantic="POSITION" source="#tri-pos"/></vertices>
        <triangles count="1"><input semantic="VERTEX" source="#tri-vtx" offset="0"/><p>0 1 2</p></triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="scene">
      <node id="easer" name="easer">
        <translate sid="location">0 0 0</translate>
        <instance_geometry url="#tri"/>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#scene"/></scene>
</COLLADA>
